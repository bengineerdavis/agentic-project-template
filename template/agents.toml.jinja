# managed by agentic-project-template (dotagents project config)
version = 1
agents = ["opencode"]

[[skills]]
name = "commit-hygiene"
source = "bengineerdavis/ai-prompt-library"

[[skills]]
name = "review-best-practices"
source = "bengineerdavis/ai-prompt-library"

# The queue's agent surface. backlog-md-py is the L5 task store, so its MCP
# server is declared by default; `mise run dotagents-install` wires it.
[[mcp]]
name = "backlog-py"
command = "backlog-py-mcp"
{% if include_consult_llm %}
[[skills]]
name = "consult"
source = "raine/consult-llm"

[[skills]]
name = "debate"
source = "raine/consult-llm"
{% endif %}
{% for skill in extra_skills %}
[[skills]]
name = "{{ skill.name }}"
source = "{{ skill.source }}"
{% endfor %}
{% for mcp in mcp_servers %}
[[mcp]]
name = "{{ mcp.name }}"
source = "{{ mcp.source }}"
{% endfor %}
